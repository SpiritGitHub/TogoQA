# PostgreSQL
POSTGRES_USER=togoqa
POSTGRES_PASSWORD=togoqa_dev
POSTGRES_DB=togoqa
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://togoqa:togoqa_dev@db:5432/togoqa

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=togoqa
MINIO_ROOT_PASSWORD=togoqa_minio_dev
