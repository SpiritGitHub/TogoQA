MINIO_BUCKET=togoqa-documents

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Frontend
VITE_API_URL=http://localhost:8000

# LLM
LLM_MODEL=Qwen/Qwen3-8B
