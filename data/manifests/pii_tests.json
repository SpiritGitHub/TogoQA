{
  "metadata": {
    "name": "TogoQA PII Test Suite",
    "version": "1.0.0",
    "synthetic_only": true,
    "purpose": "Tests fonctionnels pour le détecteur PII, le moteur de politiques et la protection des sorties."
  },
  "expected_action_order": [
    "allow",
    "mask",
    "redact",
    "pseudonymize",
    "aggregate",
    "suppress",
    "quarantine_and_review",
    "block"
  ],
  "tests": [
    {
      "id": "PII-001",
      "layer": "detector",
      "input": "Le candidat KOFFI Ama Mensah a obtenu 14/20.",
      "expected_pii": [
        "person_full_name",
        "student_grades"
      ],
      "expected_action": "block_or_aggregate"
    },
    {
      "id": "PII-002",
